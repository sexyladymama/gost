<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bac à sable activé. Autorisations limitées au strict nécessaire
	     de GHOST PERCEPTION (Mission 002) : -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Connexions sortantes uniquement (API Gmail et OAuth Google).
	     Le moteur bloque en plus toute autre destination (GuardedHTTPClient). -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Mission 005 : les dossiers de sortie choisis autorisent la création. Les sources de perception gardent leurs signets en lecture seule ; le moteur d'exécution applique ses propres autorisations. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Mémorisation de ce choix entre deux lancements (signet en lecture seule). -->
	<!-- Mission 006 : ajout au calendrier de l'utilisateur (EventKit), après son consentement et celui de macOS. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Aucune autre autorisation : pas de caméra, micro, contacts,
	     calendrier, enregistrement d'écran, ni accès complet au disque. -->
</dict>
</plist>
