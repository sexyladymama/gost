<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bac à sable activé, sans aucune autre autorisation :
	     pas de réseau, pas d'accès aux fichiers utilisateur,
	     pas de caméra, micro, contacts, etc. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
